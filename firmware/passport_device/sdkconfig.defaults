CONFIG_IDF_TARGET="esp32c3"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_FREERTOS_HZ=1000
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_ESP_CONSOLE_NONE=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=3
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=8
CONFIG_ESP_WIFI_RX_BA_WIN=3
CONFIG_ESP_WIFI_NVS_ENABLED=n
CONFIG_ESP_WIFI_ENABLE_WPA3_SAE=n
CONFIG_LOG_DEFAULT_LEVEL_NONE=y
CONFIG_ESP_TASK_WDT_EN=n
CONFIG_COMPILER_CXX_EXCEPTIONS=n
CONFIG_COMPILER_CXX_RTTI=n
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_MAX_BONDS=4
CONFIG_BT_NIMBLE_MAX_CCCDS=24
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=185
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=16
CONFIG_BT_NIMBLE_MSYS_2_BLOCK_COUNT=16
CONFIG_BT_NIMBLE_LOG_LEVEL_NONE=y
CONFIG_LWIP_PPP_SUPPORT=y
CONFIG_LWIP_PPP_ENABLE_IPV6=n
CONFIG_LWIP_PPP_NOTIFY_PHASE_SUPPORT=y
CONFIG_LWIP_ENABLE_LCP_ECHO=y
CONFIG_LWIP_LCP_ECHOINTERVAL=2
CONFIG_LWIP_LCP_MAXECHOFAILS=3

CONFIG_ESP_WIFI_RX_MGMT_BUF_NUM_DEF=2

CONFIG_BOOTLOADER_LOG_LEVEL_NONE=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
# DIO 80 MHz, as the factory firmware ran on this board (40 MHz made flash-resident LVGL drawing ~2x slower).
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_LWIP_MAX_SOCKETS=16
CONFIG_ESP_NETIF_SET_DNS_PER_DEFAULT_NETIF=y
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CA_CERT=y

CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_CROSS_SIGNED_VERIFY=y

CONFIG_WS_DYNAMIC_BUFFER=y

# RAM: IRAM code shares the C3's SRAM with the heap. Measured 38 KB more heap (0.3.78).
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_ESP_PHY_IRAM_OPT=n
# No test mode in the controller; one advert, one link and the 蓝牙声纳 scan (MAX_ACT 3).
# Keep BT_CTRL_BLE_MASTER: despite the name it is the connection feature; without it advertising fails (HCI 0x12).
CONFIG_BT_CTRL_BLE_SCAN=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_CTRL_DTM_ENABLE=n
CONFIG_BT_CTRL_BLE_MAX_ACT=3
CONFIG_HEAP_POISONING_DISABLED=y
CONFIG_SPI_MASTER_ISR_IN_IRAM=n
CONFIG_I2C_MASTER_ISR_HANDLER_IN_IRAM=n
CONFIG_ESP_EVENT_POST_FROM_IRAM_ISR=n
# Only the key timer runs on it; measured 24 B used of 3584.
CONFIG_ESP_TIMER_TASK_STACK_SIZE=2048
# 移动监控 reads the router's channel state (about 3 KB with 3 static RX buffers).
CONFIG_ESP_WIFI_CSI_ENABLED=y
# No console (CONFIG_ESP_CONSOLE_NONE): log text, assert messages and error names had nowhere to go.
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_SILENT=y
# CONFIG_ESP_ERR_TO_NAME_LOOKUP is not set
# More RAM (0.4.2): FreeRTOS, heap and the BLE controller run from flash (IDF 6.1 defaults FreeRTOS to flash;
# the old sdkconfig had kept it in IRAM). The controller's ISR is then deferred during flash writes (NVS saves).
# CONFIG_FREERTOS_IN_IRAM is not set
CONFIG_HEAP_PLACE_FUNCTION_INTO_FLASH=y
CONFIG_BT_CTRL_RUN_IN_FLASH_ONLY=y
